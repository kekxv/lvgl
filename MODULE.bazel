module(
    name = "lvgl",
    version = "9.5.0",
)

bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")
bazel_dep(name = "libx11", version = "1.8.12.bcr.5")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "apple_support", version = "2.3.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc_autoconf", version = "0.12.1")
bazel_dep(name = "sdl2", version = "2.32.0.bcr.beta.5")
bazel_dep(name = "harfbuzz", version = "14.1.0")
bazel_dep(name = "freetype", version = "2.14.1")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0")

# Required only by `--extra_toolchains=@local_config_cc//:cc-toolchain-arm64_windows` from .bazelrc
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# 极简配置：直接引入并注册，不需要任何 setup！
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

register_execution_platforms(
    "@platforms//host:host",
)

register_toolchains(
    "@local_config_cc//:all",
)

register_toolchains(
    "@zig_sdk//toolchain:aarch64-windows-gnu",
    "@zig_sdk//toolchain:windows_amd64",
    "@zig_sdk//toolchain:windows_arm64",
    "@zig_sdk//toolchain:x86_64-windows-gnu",
    "@zig_sdk//toolchain:linux_amd64_musl",
    "@zig_sdk//toolchain:linux_arm64_musl",
)
