# Generate lv_conf.h from the template, substituting @HAVE_PTHREAD@ etc.
autoconf_hdr(
    name = "gen_lv_conf_h",
    out = "conf/lv_conf.h",
    mode = "subst",
    template = ":lv_conf_h_template",
    deps = [":lvgl_config_checks"],
)

# Wrap the generated header into a cc_library so lvgl can depend on it.
# strip_include_prefix = "conf" lets downstream code `#include "lv_conf.h"`.
cc_library(
    name = "lvgl_conf",
    hdrs = [":gen_lv_conf_h"],
    strip_include_prefix = "conf",
)

# ─────────────────────────────────────────────────────────────────────────────
# LVGL core library
# ─────────────────────────────────────────────────────────────────────────────

# Source files excluded — not needed for desktop SDL2 build
_LVGL_SRCS_EXCLUDE = [
    # SDL2 OSAL: use LV_OS_PTHREAD / LV_OS_WINDOWS instead
    "src/osal/lv_sdl2.c",
    # RTOS / non-desktop OSALs (out of scope for this module)
    "src/osal/lv_freertos.c",
    "src/osal/lv_cmsis_rtos2.c",
    "src/osal/lv_rtthread.c",
    "src/osal/lv_mqx.c",
    # Display/input drivers: use SDL2; exclude native Linux/RTOS/UEFI drivers
    "src/drivers/x11/*.c",
    "src/drivers/wayland/*.c",
    "src/drivers/evdev/*.c",
    "src/drivers/libinput/*.c",
    "src/drivers/nuttx/*.c",
    "src/drivers/qnx/*.c",
    "src/drivers/uefi/*.c",
    "src/drivers/opengles/*.c",
    # Draw backends not used (software renderer is always on)
    "src/draw/nanovg/*.c",
    "src/draw/nema_gfx/*.c",
    "src/draw/dma2d/*.c",
    "src/draw/vg_lite/*.c",
    "src/draw/opengles/*.c",
    "src/draw/renesas/*.c",
    "src/draw/espressif/*.c",
    "src/draw/eve/*.c",
    "src/draw/nxp/*.c",
    # Libs that require their own Bazel deps (not yet wired up)
    "src/libs/ffmpeg/*.c",
    "src/libs/rlottie/*.c",
    "src/libs/obs/*.c",
    # ThorVG C++ sources — compiled separately in :lvgl_thorvg (requires C++14)
    "src/libs/thorvg/**/*.cpp",
    "src/debugging/vg_lite_tvg/*.cpp",
    # ARM Helium (MVE) assembly — only for ARM Cortex-M, not for x86/ARM desktop
    "src/draw/sw/blend/helium/*.S",
]

# Note: src/libs/thorvg/**/*.cpp and src/debugging/vg_lite_tvg/*.cpp are compiled
# separately in the :lvgl_thorvg target (requires C++14).

# Windows-only driver sources (included only on Windows)
_LVGL_SRCS_WINDOWS = [
    "src/drivers/windows/*.c",
    "src/osal/lv_windows.c",
]

cc_library(
    name = "lvgl",
    srcs = glob(
        include = [
            "src/**/*.c",
            "src/**/*.S",
        ],
        exclude = _LVGL_SRCS_EXCLUDE + _LVGL_SRCS_WINDOWS,
    ) + select({
        ":os_windows": glob(_LVGL_SRCS_WINDOWS),
        "//conditions:default": [],
    }),
    hdrs = glob(
        include = [
            "lvgl.h",
            "lv_version.h",
            "lvgl_private.h",  # workspace 根目录的 private header，被 examples/demos 通过相对路径引用
            "src/**/*.h",
            "include/**/*.h",  # include/ 下的公共头文件，被 src/lvgl_public.h 通过相对路径引用
        ],
        # 注意：包含 *_private.h，因为 src/**/*.c 内部需要 include 它们。
        # 这与 lvgl 的 CMake 行为一致（glob 所有 .h）。
        # 对外部消费者来说，虽然能看到 private headers，但这是 lvgl 的设计：
        # private 表示"内部 API"，不是"隐藏 API"。
    ),
    copts = select({
        # MSVC (cl.exe): MSVC-style flags
        ":compiler_msvc": [
            "/I.",
            "/D_CRT_SECURE_NO_WARNINGS",
            "/wd4018",
            "/wd4028",
            "/wd4090",
            "/wd4244",
            "/wd4267",
        ],
        # GCC / Clang / zig: POSIX-style flags
        "//conditions:default": [
            "-I.",
            "-fPIC",
            "-Wno-unused-function",
            "-Wno-unused-parameter",
            "-Wno-sign-compare",
            "-Wno-missing-field-initializers",
            "-Wno-incompatible-pointer-types",
        ],
    }),
    defines = [
        "LV_CONF_INCLUDE_SIMPLE",
        "LV_LVGL_H_INCLUDE_SIMPLE",
        "LV_KCONFIG_IGNORE",
    ],
    includes = [
        "src",  # src/**/*.h 在 include path 上
    ],
    linkopts = select({
        ":os_macos": [
            "-framework", "Cocoa",
            "-framework", "IOKit",
            "-framework", "CoreVideo",
            "-framework", "CoreFoundation",
            "-framework", "AudioToolbox",
            "-framework", "Metal",
            "-framework", "QuartzCore",
        ],
        ":os_windows": [
            "-ladvapi32",
            "-ldinput8",
            "-lgdi32",
            "-limm32",
            "-lkernel32",
            "-lole32",
            "-loleaut32",
            "-lsetupapi",
            "-lshell32",
            "-luser32",
            "-luuid",
            "-lversion",
            "-lwinmm",
        ],
        ":os_linux": [
            "-lm",
            "-ldl",
            "-lpthread",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":lvgl_conf",
        "@freetype",
        "@sdl2",
    ],
    alwayslink = True,
)

# ─────────────────────────────────────────────────────────────────────────────
# ThorVG — built-in vector graphics library (C++ sources)
# ─────────────────────────────────────────────────────────────────────────────
# Note: :lvgl and :lvgl_thorvg have a cyclic dependency (thorvg calls lvgl APIs,
# lvgl calls thorvg APIs). We break the cycle by having :lvgl_thorvg depend on
# :lvgl, and downstream targets (:lvgl_demo) depend on both.

cc_library(
    name = "lvgl_thorvg",
    srcs = glob([
        "src/libs/thorvg/**/*.cpp",
        "src/debugging/vg_lite_tvg/*.cpp",
    ]),
    hdrs = glob([
        "src/libs/thorvg/**/*.h",
        "src/debugging/vg_lite_tvg/*.h",
    ]),
    copts = select({
        ":compiler_msvc": ["/std:c++14"],
        "//conditions:default": ["-std=c++14"],
    }) + [
        "-Wno-unused-function",
        "-Wno-unused-parameter",
    ],
    includes = [
        "src/debugging/vg_lite_tvg",
        "src/libs/thorvg",
    ],
    deps = [":lvgl"],
    alwayslink = True,
)

# ─────────────────────────────────────────────────────────────────────────────
# Demos / Examples
# ─────────────────────────────────────────────────────────────────────────────

cc_library(
    name = "lvgl_demos",
    srcs = glob(["demos/**/*.c"]),
    hdrs = glob(["demos/**/*.h"]),
    includes = ["demos"],
    deps = [":lvgl"],
    alwayslink = True,
)

cc_library(
    name = "lvgl_examples",
    srcs = glob(["examples/**/*.c"]),
    hdrs = glob(["examples/**/*.h"]),
    includes = ["examples"],
    deps = [":lvgl"],
    alwayslink = True,
)

# ─────────────────────────────────────────────────────────────────────────────
# Demo binary
# ─────────────────────────────────────────────────────────────────────────────

cc_binary(
    name = "lvgl_demo",
    srcs = ["apps/lvgl_demo_main.c"],
    deps = [
        ":lvgl",
        ":lvgl_thorvg",
        ":lvgl_demos",
        ":lvgl_examples",
    ],
)

