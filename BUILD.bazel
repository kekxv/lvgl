"""BUILD file for LVGL as a Bazel module.

Targets:
    //:lvgl            — core library (src/**)
    //:lvgl_thorvg     — ThorVG vector graphics library (built-in source)
    //:lvgl_conf       — generated lv_conf.h (via autoconf_hdr)
    //:lvgl_demos      — demos library
    //:lvgl_examples   — examples library
    //:lvgl_demo       — binary that runs lv_demo_widgets via SDL2

Platform support: Linux, macOS, Windows, Buildroot (cross-compile via --platforms).

lv_conf.h is generated at build time by rules_cc_autoconf, which probes the
target toolchain for pthread, windows.h. The template lives at conf/lv_conf.h.template.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks")
load("@rules_cc_autoconf//autoconf:defs.bzl", "autoconf", "autoconf_hdr")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # MIT

# ─────────────────────────────────────────────────────────────────────────────
# Platform detection
# ─────────────────────────────────────────────────────────────────────────────

config_setting(
    name = "os_linux",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "os_macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "os_windows",
    constraint_values = ["@platforms//os:windows"],
)

# 基于编译器类型的检测（用于区分 MSVC 和 GCC/Clang/zig）
config_setting(
    name = "compiler_msvc",
    flag_values = {"@bazel_tools//tools/cpp:compiler": "msvc-cl"},
)

# ─────────────────────────────────────────────────────────────────────────────
# autoconf: detect features on the target toolchain
# ─────────────────────────────────────────────────────────────────────────────
# `subst = "NAME"` makes autoconf_hdr (mode = "subst") substitute @NAME@
# with 1 (feature found) or 0 (not found) inside the template.

LVGL_CONFIG_CHECKS = [
    # pthread — OSAL on Linux/macOS/POSIX
    checks.AC_CHECK_HEADER(
        "pthread.h",
        define = "HAVE_PTHREAD",
        subst = "HAVE_PTHREAD",
    ),
    # windows.h — OSAL on Windows
    checks.AC_CHECK_HEADER(
        "windows.h",
        define = "HAVE_WINDOWS_H",
        subst = "HAVE_WINDOWS_H",
    ),
]

autoconf(
    name = "lvgl_config_checks",
    checks = LVGL_CONFIG_CHECKS,
)

